# Copy this file to .env.local (gitignored) to run local release builds without
# exporting anything in your shell. scripts/Publish-LocalRelease.ps1 reads these
# values only when the real environment does not already set them.
#
# Vite loads .env.local too, but it only exposes VITE_ variables to the frontend,
# so the signing key never reaches the app bundle.

# Private key path, or the key content itself. When empty the script looks for
# <repo>/araview.key and then ~/.tauri/araview.key.
TAURI_SIGNING_PRIVATE_KEY=

# Key password. Leave the value empty if the key has no password.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
