{
  "name": "araview",
  "version": "1.1.1",
  "private": true,
  "license": "EUPL-1.2",
  "type": "module",
  "scripts": {
    "audit:frontend": "node scripts/audit-frontend.mjs",
    "build": "tsc && vite build",
    "build:thumb": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/Build-ThumbDll.ps1",
    "dev": "vite",
    "dev:up": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/Start-TauriDev.ps1",
    "docs:check": "node scripts/check-docs.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "release": "node scripts/release.mjs",
    "tauri": "tauri",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.41",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.3",
    "@tauri-apps/plugin-opener": "~2.5.5",
    "@tauri-apps/plugin-store": "~2.4.4",
    "@tauri-apps/plugin-updater": "~2.11.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "i18next": "^26.4.2",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "tailwindcss": "^4.3.3",
    "tauri-plugin-snap-layout": "^1.0.9",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.0",
    "@tanstack/router-plugin": "^1.168.42",
    "@tauri-apps/cli": "~2.11.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "shadcn": "^4.21.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
