{
  "$schema": "https://cdn.jsdelivr.net/npm/oxlint@latest/configuration_schema.json",
  "jsPlugins": ["@shadcn/lint"],
  "settings": {
    "shadcn": {
      "note": "See DESIGN.md for design rules and approved exceptions."
    }
  },
  "rules": {
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout", "no-drag"],
        "contracts": [
          { "pattern": "^ScrollArea$", "allow": ["layout", "spacing"] },
          { "pattern": "^Empty$", "allow": ["layout", "border-none"] },
          {
            "pattern": "^(Dialog|Sheet|Drawer|AlertDialog)(Content|Header|Footer)$",
            "allow": ["layout", "spacing", "border-b", "no-drag"]
          },
          {
            "pattern": "^Field(Group|Legend)$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^Button$",
            "allow": [
              "layout",
              "bg-primary",
              "text-primary",
              "border-primary",
              "hover:bg-destructive/10",
              "hover:text-destructive",
              "dark:hover:bg-destructive/20",
              "font-mono",
              "tabular-nums"
            ]
          },
          {
            "pattern": "^ButtonGroupText$",
            "allow": [
              "layout",
              "no-drag",
              "typography",
              "focus-visible:ring-2",
              "focus-visible:ring-ring",
              "focus-visible:outline-none",
              "opacity-50"
            ]
          },
          { "pattern": "^Spinner$", "allow": ["layout", "color"] },
          {
            "pattern": "^AttachmentDescription$",
            "allow": ["layout", "text-muted-foreground"]
          }
        ]
      }
    ],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": [
      "error",
      {
        "allow": [
          "layout",
          "fill-[#171717]",
          "fill-[#525252]",
          "fill-[#F5F5F5]",
          "text-[10px]",
          "text-[11px]",
          "transition-[grid-template-rows]",
          "transition-[translate,opacity]"
        ]
      }
    ],
    "shadcn/no-inline-styles": [
      "error",
      {
        "allow": [
          "width",
          "height",
          "maxWidth",
          "maxHeight",
          "left",
          "top",
          "transform",
          "cursor",
          "animation"
        ]
      }
    ],
    "shadcn/no-unknown-classes": ["warn", { "allow": ["toaster"] }],
    "shadcn/require-static-classes": "error"
  },
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/require-static-classes": "off"
      }
    },
    {
      "files": ["**/*.test.{ts,tsx}"],
      "rules": {
        "shadcn/no-raw-colors": "off",
        "shadcn/no-unknown-classes": "off"
      }
    }
  ],
  "ignorePatterns": [".opencode/**", ".agents/**"]
}
