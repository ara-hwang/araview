{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "trailingComma": "none",
  "tabWidth": 2,
  "semi": false,
  "sortPackageJson": {
    "sortScripts": true
  },
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "./src/App.css",
    "functions": ["cn", "clsx", "cva"]
  },
  "ignorePatterns": [
    ".agents",
    ".cursor",
    ".opencode",
    "src-tauri",
    "src/components/ui",
    "**/routeTree.gen.ts",
    "THIRD_PARTY_LICENSES.md",
    "THIRD_PARTY_LICENSES.json",
    ".DS_Store",
    "node_modules",
    "/build",
    "/.svelte-kit",
    "/package",
    ".env",
    ".env.*",
    "pnpm-lock.yaml",
    "package-lock.json",
    "yarn.lock"
  ]
}
