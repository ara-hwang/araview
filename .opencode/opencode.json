{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "formatter": {
    "oxfmt-json": {
      "command": ["npx", "oxfmt", "$FILE"],
      "extensions": [".json", ".jsonc"]
    },
    "oxfmt-css": {
      "command": ["npx", "oxfmt", "$FILE"],
      "extensions": [".css"]
    }
  },
  "permission": {
    "websearch": "allow",
    "webfetch": "allow",
    "external_directory": "ask",
    "doom_loop": "ask",
    "bash": {
      "rm -rf *": "deny",
      "git push *": "ask"
    },
    "skill": {
      "agent-browser": "deny"
    }
  },
  "mcp": {
    "tauri": {
      "type": "local",
      "command": ["npx", "-y", "@hypothesi/tauri-mcp-server"],
      "environment": {
        "MCP_BRIDGE_PORT": "9323"
      },
      "enabled": true
    }
  }
}
